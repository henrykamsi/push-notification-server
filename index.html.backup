<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sendly Notification</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: #0f0f1a;
            color: #ffffff;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }
        .container {
            max-width: 500px;
            width: 100%;
            text-align: center;
        }
        .logo {
            font-size: 56px;
            margin-bottom: 12px;
        }
        h1 {
            font-size: 32px;
            font-weight: 700;
            background: linear-gradient(135deg, #7c3aed, #a855f7);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 4px;
        }
        .subtitle {
            color: #94a3b8;
            margin-bottom: 28px;
            font-size: 15px;
        }
        .card {
            background: #1e1e2e;
            border-radius: 16px;
            padding: 32px;
            border: 1px solid #2d2d44;
        }
        .card h2 {
            font-size: 18px;
            color: #e2e8f0;
            margin-bottom: 16px;
        }
        .input-group {
            margin-bottom: 16px;
            text-align: left;
        }
        .input-group label {
            display: block;
            font-size: 13px;
            color: #94a3b8;
            margin-bottom: 6px;
        }
        .input-group input {
            width: 100%;
            padding: 12px 16px;
            border-radius: 8px;
            border: 1px solid #2d2d44;
            background: #0f0f1a;
            color: #ffffff;
            font-size: 14px;
            font-family: 'Courier New', monospace;
            outline: none;
            transition: border 0.3s;
        }
        .input-group input:focus {
            border-color: #7c3aed;
        }
        .input-group input::placeholder {
            color: #4a4a5a;
        }
        .btn {
            width: 100%;
            padding: 14px;
            border: none;
            border-radius: 8px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.3s, transform 0.1s;
        }
        .btn-primary {
            background: #7c3aed;
            color: #ffffff;
        }
        .btn-primary:hover {
            background: #6d28d9;
        }
        .btn-primary:active {
            transform: scale(0.97);
        }
        .btn-primary:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }
        .btn-success {
            background: #22c55e;
            color: #ffffff;
        }
        .btn-success:hover {
            background: #16a34a;
        }
        .status {
            margin-top: 16px;
            padding: 12px;
            border-radius: 8px;
            font-size: 14px;
            display: none;
        }
        .status.show {
            display: block;
        }
        .status.success {
            background: rgba(34, 197, 94, 0.15);
            color: #22c55e;
            border: 1px solid rgba(34, 197, 94, 0.3);
        }
        .status.error {
            background: rgba(239, 68, 68, 0.15);
            color: #ef4444;
            border: 1px solid rgba(239, 68, 68, 0.3);
        }
        .status.info {
            background: rgba(124, 58, 237, 0.15);
            color: #a855f7;
            border: 1px solid rgba(124, 58, 237, 0.3);
        }
        .footer {
            margin-top: 20px;
            color: #4a4a5a;
            font-size: 13px;
        }
        .footer span {
            color: #7c3aed;
        }
        .api-key-display {
            background: #0f0f1a;
            padding: 10px 14px;
            border-radius: 8px;
            font-family: 'Courier New', monospace;
            font-size: 13px;
            color: #a855f7;
            border: 1px solid #2d2d44;
            margin-top: 12px;
            word-break: break-all;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="logo">🔔</div>
        <h1>Sendly Notification</h1>
        <p class="subtitle">Enable push notifications on this device</p>

        <div class="card">
            <h2>📱 Enable Notifications</h2>

            <div class="input-group">
                <label for="apiKeyInput">Enter your Sendly API Key</label>
                <input type="text" id="apiKeyInput" placeholder="sendly_live_..." value="sendly_live_testapp_ab965eae53e20ebd3e3d80244627cfef">
            </div>

            <button id="enableBtn" class="btn btn-primary">🔔 Enable Notifications</button>

            <div id="statusMessage" class="status"></div>

            <div id="subscriberInfo" style="display: none; margin-top: 16px;">
                <div style="font-size: 13px; color: #94a3b8; margin-bottom: 6px;">✅ Subscribed as:</div>
                <div class="api-key-display" id="deviceInfo">Device registered</div>
            </div>
        </div>

        <div class="footer">
            Built with ❤️ by <span>Henry Global Tech Industry</span> | &copy; 2026
        </div>
    </div>

    <script>
        (function() {
            const SERVER_URL = 'https://push-notification-server-5tx2.onrender.com';

            const apiKeyInput = document.getElementById('apiKeyInput');
            const enableBtn = document.getElementById('enableBtn');
            const statusMessage = document.getElementById('statusMessage');
            const subscriberInfo = document.getElementById('subscriberInfo');
            const deviceInfo = document.getElementById('deviceInfo');

            function setStatus(message, type) {
                statusMessage.textContent = message;
                statusMessage.className = 'status show ' + type;
            }

            function hideStatus() {
                statusMessage.className = 'status';
            }

            function urlBase64ToUint8Array(base64String) {
                const padding = '='.repeat((4 - base64String.length % 4) % 4);
                const base64 = (base64String + padding).replace(/\-/g, '+').replace(/_/g, '/');
                const rawData = window.atob(base64);
                const outputArray = new Uint8Array(rawData.length);
                for (let i = 0; i < rawData.length; ++i) {
                    outputArray[i] = rawData.charCodeAt(i);
                }
                return outputArray;
            }

            async function registerServiceWorker(apiKey) {
                try {
                    // Check if notifications are supported
                    if (!('Notification' in window)) {
                        setStatus('❌ Notifications are not supported in this browser.', 'error');
                        return false;
                    }

                    // Check if service workers are supported
                    if (!('serviceWorker' in navigator)) {
                        setStatus('❌ Service Workers are not supported in this browser.', 'error');
                        return false;
                    }

                    // Request permission
                    setStatus('⏳ Requesting notification permission...', 'info');
                    enableBtn.disabled = true;

                    const permission = await Notification.requestPermission();

                    if (permission !== 'granted') {
                        setStatus('❌ Notification permission was denied. Please enable it in browser settings.', 'error');
                        enableBtn.disabled = false;
                        return false;
                    }

                    setStatus('⏳ Registering service worker...', 'info');

                    // Register service worker
                    const swUrl = SERVER_URL + '/sw.js';
                    const reg = await navigator.serviceWorker.register(swUrl);
                    console.log('Service worker registered:', reg);

                    setStatus('⏳ Getting VAPID key...', 'info');

                    // Get VAPID key
                    const keyRes = await fetch(SERVER_URL + '/api/v1/vapid-key');
                    const keyData = await keyRes.json();

                    if (!keyData.publicKey) {
                        setStatus('❌ Failed to get VAPID key from server.', 'error');
                        enableBtn.disabled = false;
                        return false;
                    }

                    setStatus('⏳ Creating push subscription...', 'info');

                    // Subscribe to push
                    const subscription = await reg.pushManager.subscribe({
                        userVisibleOnly: true,
                        applicationServerKey: urlBase64ToUint8Array(keyData.publicKey)
                    });

                    setStatus('⏳ Sending subscription to server...', 'info');

                    // Send subscription to server
                    const response = await fetch(SERVER_URL + '/api/v1/subscribe', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'x-sendly-key': apiKey
                        },
                        body: JSON.stringify(subscription)
                    });

                    const data = await response.json();

                    if (data.status === 100) {
                        setStatus('✅ Device registered successfully! You will now receive notifications.', 'success');
                        enableBtn.textContent = '✅ Subscribed';
                        enableBtn.className = 'btn btn-success';
                        enableBtn.disabled = true;

                        // Show subscriber info
                        subscriberInfo.style.display = 'block';
                        deviceInfo.textContent = 'Device subscribed to ' + apiKey;

                        // Store in localStorage
                        localStorage.setItem('sendly_subscribed', 'true');
                        localStorage.setItem('sendly_api_key', apiKey);

                        return true;
                    } else {
                        setStatus('❌ Registration failed: ' + (data.message || 'Unknown error'), 'error');
                        enableBtn.disabled = false;
                        return false;
                    }

                } catch (error) {
                    console.error('Registration error:', error);
                    setStatus('❌ Error: ' + error.message, 'error');
                    enableBtn.disabled = false;
                    return false;
                }
            }

            // Check if already subscribed
            function checkExistingSubscription() {
                const savedKey = localStorage.getItem('sendly_api_key');
                const subscribed = localStorage.getItem('sendly_subscribed') === 'true';

                if (subscribed && savedKey) {
                    apiKeyInput.value = savedKey;
                    enableBtn.textContent = '✅ Already Subscribed';
                    enableBtn.className = 'btn btn-success';
                    enableBtn.disabled = true;
                    subscriberInfo.style.display = 'block';
                    deviceInfo.textContent = 'Device subscribed to ' + savedKey;
                    setStatus('✅ You are already subscribed to this API key.', 'success');
                }
            }

            // Enable button click handler
            enableBtn.addEventListener('click', function() {
                const apiKey = apiKeyInput.value.trim();

                if (!apiKey) {
                    setStatus('❌ Please enter your Sendly API key.', 'error');
                    return;
                }

                if (!apiKey.startsWith('sendly_live_')) {
                    setStatus('❌ Invalid API key format. Should start with "sendly_live_"', 'error');
                    return;
                }

                registerServiceWorker(apiKey);
            });

            // Check on load
            checkExistingSubscription();

            // Expose for debugging
            window.sendlyTest = {
                register: registerServiceWorker,
                setStatus: setStatus,
                hideStatus: hideStatus
            };

            console.log('Sendly: Test page loaded');
        })();
    </script>
</body>
</html>
